+UI_INLINE int ui_max(int a, int b) {
+    return (a>b)?a:b;
+}
+
+UI_INLINE int ui_min(int a, int b) {
+    return (a<b)?a:b;
+}
+
+UI_INLINE float ui_maxf(float a, float b) {
