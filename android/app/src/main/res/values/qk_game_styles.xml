<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 游戏内对话框：圆角 16dp + 表面色 + 1dp 描边（AppCompat AlertDialog 走 alertDialogTheme） -->
    <style name="QookixAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/qk_dialog_bg</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="colorAccent">@color/qk_accent</item>
        <item name="android:textColorPrimary">@color/qk_text_1</item>
        <item name="android:textColorSecondary">@color/qk_text_2</item>
        <item name="android:textColorHint">@color/qk_text_3</item>
        <item name="android:divider">@color/qk_divider</item>
        <item name="android:listDivider">@color/qk_divider</item>
        <!-- 对话框按钮默认会跟 android:textColorPrimary 变成白色，这里单独指定强调色 -->
        <!-- 对话框按钮样式：AppCompat 的 AlertDialog 按钮栏读的是 buttonBar* 系列属性，
             只设 buttonStyle 不生效（按钮会跟着 android:textColorPrimary 变白）。 -->
        <item name="buttonStyle">@style/QookixDialogButton</item>
        <item name="android:buttonBarButtonStyle">@style/QookixDialogButton</item>
        <item name="buttonBarButtonStyle">@style/QookixDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/QookixDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/QookixDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/QookixDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/QookixDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/QookixDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/QookixDialogButton</item>
    </style>

    <style name="QookixDialogButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/qk_accent_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- 侧栏面板里的文字按钮（取消 / 确定） -->
    <style name="QookixTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/qk_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/qk_button_ghost</item>
    </style>

    <!-- 侧栏面板标题 -->
    <style name="QookixPanelTitle" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/qk_text_1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 设置项标签 / 数值 -->
    <style name="QookixSettingLabel">
        <item name="android:textColor">@color/qk_text_2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="QookixSettingValue">
        <item name="android:textColor">@color/qk_accent_light</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="QookixSettingSwitch">
        <item name="android:textColor">@color/qk_text_2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 抽屉标题 -->
    <style name="QookixMenuTitle">
        <item name="android:textColor">@color/qk_text_1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="QookixMenuSubtitle">
        <item name="android:textColor">@color/qk_text_3</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
