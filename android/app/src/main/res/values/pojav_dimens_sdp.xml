<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pojav 的布局/控件用的是 portrait-sdp / portrait-ssp（JitPack）里的 _NNsdp / _NNssp 尺寸。
      本机开发环境无法访问 JitPack（SSL 不通），故在此按 1:1 生成等值 dp/sp 资源。
      差异：原库会按屏幕最短边对尺寸做整体缩放，这里不做缩放。
      影响仅限少数图标按钮的视觉大小，不影响任何交互逻辑。
    -->
    <dimen name="_1sdp">1dp</dimen>
    <dimen name="_2sdp">2dp</dimen>
    <dimen name="_4sdp">4dp</dimen>
    <dimen name="_5sdp">5dp</dimen>
    <dimen name="_6sdp">6dp</dimen>
