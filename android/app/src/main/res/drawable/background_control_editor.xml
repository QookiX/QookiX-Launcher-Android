<?xml version="1.0" encoding="utf-8"?>
<!-- 侧栏面板背景（控制编辑器 / 快速设置共用）。
     由 SideDialogView 以代码 setBackground 引用，改这里即可统一换肤。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <padding
        android:bottom="@dimen/padding_small"
        android:left="@dimen/padding_small"
        android:right="@dimen/padding_small"
        android:top="@dimen/padding_small" />
    <solid android:color="@color/qk_surface_float" />
    <stroke android:width="1dp" android:color="@color/qk_border" />
</shape>
