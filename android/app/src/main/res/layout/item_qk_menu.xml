<?xml version="1.0" encoding="utf-8"?>
<!--
  游戏内菜单 / 编辑器菜单的列表项。
  外层负责左右留白（ListView 不支持 item margin），内层承载圆角涟漪背景。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/qk_menu_item_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/qk_menu_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:tint="@color/qk_accent_light" />

        <TextView
            android:id="@+id/qk_menu_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/qk_text_1"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
