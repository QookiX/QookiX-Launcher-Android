<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 自动更新：下载完 APK 后交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      前台服务类型对应的权限：Android 14+ 起，没有这条权限 startForeground() 会被系统拒绝
      （ForegroundServiceStartNotAllowedException），游戏进程就没有保护，
      切后台很容易被 lowmemorykiller 杀掉 —— 表现就是「切出去再回来游戏没了/闪退」。
      Pojav 声明的是 DATA_SYNC + SPECIAL_USE 两条。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 关于页彩蛋：曲奇炸碎时 navigator.vibrate 触发一下震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 控制布局可以通过 content:// 从外部导入（Pojav 的 ImportControlActivity 同款） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      「所有文件访问」（MANAGE_EXTERNAL_STORAGE）。

      **这条以前漏了，结果是「设置 → 游戏目录 → 授权」根本走不通**：
      它是 Android 11+ 的特殊访问权限，**必须在清单里声明**，系统才会把本应用列入
      「所有文件访问」那一栏；没声明的话小米/HyperOS 的权限页里这一项是**灰色点不动**的
      （别的 ROM 直接不显示），Environment.isExternalStorageManager() 也永远返回 false
      —— 启动器就一直以为没授权，用户点多少次都没用。

      为什么需要它：自定义游戏目录要支持「任意共享存储路径」（如 /sdcard/Documents/mc），
      而游戏 JVM 和 Rust 的 std::fs 都只能拿**真实路径**（SAF 的 content:// URI 两边都用不了），
      所以必须能直接读写那些目录，而不只是 SAF 授权的那一个。

      注：targetSdk 36 不影响系统授予（只有 Google Play 的政策审核会管这个权限，
      侧载安装不受限制）。requestLegacyExternalStorage 对 targetSdk≥30 已被系统忽略。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      组播锁（`WifiManager.MulticastLock`）需要这条权限，否则 acquire 抛
      SecurityException（`WifiServiceImpl.enforceMulticastChangePermission`）。
      它是「陶瓦联机 + 自建服」能跑起来的前提：Terracotta 的服务器扫描器靠
      `bind(4445) + join_multicast(224.0.2.60)` 收包，我们自建服要靠
      `[MOTD]…[/AD]<端口>[/AD]` 组播包把端口报给它（见TerracottaTunnelService 的类注释）。
      实测缺这条时锁申请会失败；部分 ROM 上仍能收到包（宽松），严格的设备上会扫不到服务器。
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      电池优化（Doze / App Standby）豁免。
      服务器跑在 `:server` 前台服务里，但 ColorOS / OnePlus 这类 ROM 的省电策略会在
      息屏一段时间后把**不在白名单**的应用的后台服务掐掉 —— 表现就是「开服玩一会儿，
      服自己没了、通知也消失」。
      ⚠️ 这条权限**不会自动生效**：系统会弹窗让用户点「允许」，我们只负责引导
      （`MainActivity.requestIgnoreBatteryOptimizations`）。不引导的话用户根本不知道
      要去设置里放行，也就一直被掐。竞品 Anvil-MC 也申请了这条。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      陶瓦联机的 VPN（TUN）。

      EasyTier 的**数据面**必须走 TUN：房主把mesh 上的入站流量转成「连本机 25565」，
      客人才连得进来。Terracotta 不自己申请 VPN，而是把请求交给宿主App
      （`TerracottaAndroidAPI.VpnServiceCallback`），由我们建隧道。

      不声明 BIND_VPN_SERVICE / 不注册这个服务 → 房间里只有房主
      （真机症状：电脑端加入报「连接发生错误」，房主 profiles 里只有自己）。
      服务必须跑在 `:tunnel` 进程 —— `libterracotta.so` 只在那里加载，
      跨进程没法把 `ParcelFileDescriptor` 交给 native。
    -->
    <!--
      注意：这里**不需要**（也不能）用 `<uses-permission>` 声明 BIND_VPN_SERVICE。
      它是 signature 级权限，只归系统所有，普通 App 申请也永远不会被授予；
      真正起作用的是下面 `<service ... android:permission="android.permission.BIND_VPN_SERVICE">`
      那一句（它保证只有系统能 bind 这个服务，也是 VpnService 框架的识别条件）。
      原来这里多写了一条 uses-permission，容易被误解成「有它才能用 VPN」。
    -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.qookix_launcher"
        android:allowNativeHeapPointerTagging="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <!--
          旧 WebView 入口。

          ⚠️ **已不再是桌面入口**（2026-10-13 起 LAUNCHER 移到 Compose 版）。

          它现在的作用：
            1. 提供 19 项原生能力的历史实现（能力已收敛到 HostCapabilities，
               两个入口共用 —— 这里保留是为了不动既有代码）
            2. 兜底入口，只在 adb 显式指定时才会启动

          ⚠️ 注意：它现在**没有可显示的界面**。
          前端资源已被替换成最小引导页（bootstrap/index.html），
          而旧界面本来就靠 Vue 渲染 —— Vue 不在包里了，所以它是一片空白。

          换句话说：它现在只是一个「IPC 端点 + 能力宿主」，
          真正的界面在 Compose 版里。
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:alwaysRetainTaskState="true"
            android:exported="true">
        </activity>

        <!--
          Compose 版启动器界面 —— **桌面主入口**。

          2026-10-13 起 LAUNCHER intent-filter 从旧 MainActivity 移到这里。
          前置条件（6/6）已全部达成，见 COMPOSE-PHASE5-READY.md：
            1. 19 项原生能力（HostCapabilities）
            2. TauriBridge.attach(this)
            3. onCreate 初始化三项（控制布局播种 / 中转清理 / 断点续启）
            4. WebView 与 Vue 脱钩（引导页 4.6 KB）
            5. 返回键处理（Compose 导航栈）
            6. 音量键缩放

          ── screenOrientation 说明 ──────────────────────────────────────
          用 `sensorLandscape`（横屏优先，两个方向都允许）—— 按用户要求
          新界面先做横屏形态（NavigationRail 左侧栏）。

          将来补竖屏形态时改成 `fullSensor` 即可（Compose 侧已按
          window size class 自适应，见 shell/WindowSize.kt）。

          configChanges 与 MainActivity 保持一致，避免切换时 Activity 重建。
        -->
        <activity
            android:name=".compose.ComposeMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Game Activity (Fullscreen game rendering)

          进入游戏之后的逻辑完全照 PojavLauncher 的 MainActivity：
            - configChanges 必须包含 keyboard|navigation|uiMode，否则旋转/系统栏变化时
              onConfigurationChanged 不会触发，控制按钮与游戏窗口尺寸也不会重算；
            - screenOrientation="sensorLandscape"：横屏两个方向都允许（GyroControl 会据此
              修正陀螺仪轴向；固定的 landscape 会让反向握持时视角反向）；
            - launchMode="singleTask"：游戏 JVM 与这个界面绑在一起，从启动器再点一次
              「启动游戏」必须复用已有实例，否则两个 GameActivity 会抢同一个 Surface / 同一个 JVM。

          与 Pojav 的差异：**不加 android:process=":game"**。QookiX 的游戏 JVM 是
          在应用进程内通过 JNI 创建的（libqookix_lib.so 持有 JVM 与 Surface 桥），
          拆到独立进程会让两边拿到各自的 pojav_environ / 输入队列，直接失去输入与渲染。
        -->
        <!-- 2026-10-05 实测项：给游戏界面一个独立 taskAffinity。
             不写时它与 MainActivity 共用「包名 affinity」→ 最近任务里只有一条卡，
             进了游戏就再也切不回启动器。独立 affinity 后 recents 会出现两条
             （启动器 / 游戏），可以互相切换、也能切回启动器。
             仍是 singleTask → 从启动器再点一次「启动游戏」照样复用同一个实例，
             不会开出第二个 GameActivity 去抢 Surface / JVM。 -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.zhayi.qookix.game"
            android:documentLaunchMode="intoExisting"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:theme="@style/Theme.qookix_game" />

        <!--
          控制布局编辑器（全屏、可拖动按钮/摇杆/抽屉）。
          来自 PojavLauncher 的 net.kdt.pojavlaunch.CustomControlsActivity。
        -->
        <activity
            android:name="net.kdt.pojavlaunch.CustomControlsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation"
            android:exported="false"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="net.kdt.pojavlaunch.CustomControlsActivity" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          从外部导入控制布局。

          为什么既有 content:// 又有 file://、还带了 octet-stream：
          文件管理器（尤其 MT）分享一个 .json 时，给的 MIME 很不统一 ——
          有的给 application/json，有的给 application/octet-stream（它不认扩展名），
          有的干脆给 file://。**只认 application/json 的话，用户在 MT 里
          长按分享根本看不到 QookiX 这个选项**（intent-filter 不匹配，系统不列出来）。
          所以这几种都接上；真正的校验在代码里（必须有 version + mControlDataList）。
        -->
        <activity
            android:name="net.kdt.pojavlaunch.ImportControlActivity"
            android:configChanges="keyboard|keyboardHidden"
            android:exported="true"
            android:launchMode="singleInstance"
            android:windowSoftInputMode="stateVisible">
            <intent-filter android:label="@string/import_control_label">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="text/json" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/json" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="application/x-json" />
            </intent-filter>
            <!-- 有些文件管理器分享时不给 MIME（只有 ACTION_VIEW + URI），
                 用 pathPattern 兜底匹配 .json；不写 mimeType 以免匹配所有文件。 -->
            <intent-filter android:label="@string/import_control_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" android:pathPattern=".*\\.json" />
            </intent-filter>
        </activity>

        <!-- Game Service (Foreground) -->
        <!--
          foregroundServiceType 用 specialUse（Pojav 也是这么声明的）：
          dataSync 在 Android 15+ 有「6 小时/24 小时」上限，超时会被系统停掉，
          表现就是「玩一会儿切后台就被杀」。specialUse 需要下面的 property 说明用途。
        -->
        <!-- 不设 stopWithTask（默认即 false）—— 改由 GameService.onTaskRemoved()
             主动收尾（先杀游戏再停服务）。否则从最近任务划掉启动器后，
             同进程的 JVM 会继续跑、却再也看不到界面（问题清单 P0-15）。 -->
        <service
            android:name=".services.GameService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持 Minecraft Java 版游戏进程在前台存活，避免切到后台被系统回收" />
        </service>

        <!-- 启动器守护：**必须跑在独立进程**（:guard）。
             游戏 JVM 与启动器同进程，而游戏内「强制关闭」会让游戏 JVM 调
             System.exit(0) → os::exit() 把整个进程带走，启动器跟着消失、
             用户被送回桌面。这个守护进程独立于主进程，主进程被带走时它还活着，
             检测到就把启动器重新拉起来（详见 GameGuardService 的注释）。 -->
        <!-- 陶瓦联机隧道：**独立进程**（:tunnel），`libterracotta.so` 只在这里加载。
             之所以不放在主进程：Terracotta 是 AGPL-3.0，其 README 给了例外
             （未修改二进制 + 不链接，或 IPC 交互 + 界面署名）。我们用「独立进程 + localhost HTTP」，
             启动器不链接它，可保持 GPL-3.0。署名见设置页「第三方声明」。 -->
        <!-- foregroundServiceType 必须声明：Android 14（API 34）起不带类型调
             startForeground 会抛 MissingForegroundServiceTypeException，实测现象是
             通知根本不出现（房间码也就看不见），异常被 runCatching 吞掉。 -->
        <service
            android:name=".tunnel.TerracottaTunnelService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":tunnel">
            <!-- specialUse 必须说明具体用途（Android 14+ 强制要求，否则装不上/被杀） -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持 Minecraft 联机隧道（陶瓦/EasyTier 房间）常驻，使房间码与对外地址持续可用" />
        </service>

        <!-- 陶瓦联机的 VPN（TUN）：必须与 :tunnel 同进程，详见上方 BIND_VPN_SERVICE 处的说明 -->
        <service
            android:name=".tunnel.TerracottaVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":tunnel">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".services.GameGuardService"
            android:exported="false"
            android:process=":guard" />

        <!-- Minecraft 服务端：**独立进程**（:server）。
             服务端是另一个 JVM（内存几百 MB ~ 数 GB），必须与主进程隔离：
             ① 放主进程时服务端触发系统 OOM，用户在 UI 里操作也会被一起杀掉，服务器陪葬；
             ② 服务端 JVM 崩溃 / core dump 会直接带走启动器（表现是「开服后应用闪退」）。
             独立进程后主进程始终存活，UI 能读到退出原因并提示。
             通信方式与 :tunnel 一致：launch.json 下发参数 + localhost HTTP IPC（带 token 校验）。 -->
        <service
            android:name=".services.ServerService"
            android:exported="false"
            android:process=":server"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <!-- 同上：specialUse 要带 subtype 说明。
                 之前这里是 dataSync，在 Android 15+ 有 6h/24h 硬上限，
                 长期开服会被系统停掉（表现「玩一会儿服就没了」）。
                 注意 ServerService.startForegroundCompat() 里传的运行时类型
                 必须同步改成 FOREGROUND_SERVICE_TYPE_SPECIAL_USE，否则会崩。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="托管用户自行创建的 Minecraft 服务端，需要以后台进程长时间运行 Java 服务端 JVM" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
              android:name="android.support.FILE_PROVIDER_PATHS"
              android:resource="@xml/file_paths" />
        </provider>

        <!--
          服务器文件目录（files/servers/）作为「文档提供者」暴露给系统文件管理器。

          为什么要它：服务器文件在应用私有区，第三方管理器进不去。FileProvider 只能给
          **单个文件**造 URI（把目录交给 ACTION_VIEW 时，系统文件应用只会打开它自己的首页，
          实测列不出目录），要「浏览/拷入/拷出整个目录」只能用 DocumentsProvider。

          MANAGE_DOCUMENTS 是 signature 级权限（归系统所有）：写在这里表示**只有系统**
          （SAF / 文件管理器）能访问本 provider，其它应用仍需用户授权 URI 才行 —— 不需要
          也无法在 <uses-permission> 里申请它。
        -->
        <provider
            android:name=".ServerDocsProvider"
            android:authorities="${applicationId}.serverdocs"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
