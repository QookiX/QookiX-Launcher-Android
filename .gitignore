# ── 依赖与构建产物 ──────────────────────────────────────────────
node_modules/
dist/

# Gradle / Android：任何层级的 build/ 都是产物
.gradle/
build/
local.properties
*.apk
*.aab
*.idsig
*.jks
*.keystore

# Rust
src-tauri/target/

# ── 仅本机使用的构建辅助（内含本机绝对路径，不入库）────────────────
# CI 用环境变量提供 NDK 链接器（见 .github/workflows/release.yml），
# 本机编译仍用磁盘上这份 config.toml（已忽略，不随仓库分发）。
src-tauri/.cargo/config.toml
/copy_tauri.bat
/copy_tauri.ps1

# 我们自己编出来的原生库。
# **不要写成 `*.so`** —— 同目录下 liblwjgl*/libopenal/libOSMesa/libgl4es_114/
# libvulkan_freedreno/libfreetype/libjnidispatch/libunpack200 都是随仓库携带的
# 预编译资产，是构建的必需输入，忽略掉就再也编不出能跑的包了。
src-tauri/gen/android/app/src/main/jniLibs/*/libqookix_lib.so
app/src/main/jniLibs/*/libqookix_lib.so
# 误提交过一份到 src-tauri/ 根目录（215MB，debug 产物）——正确位置是 target/ 与 jniLibs/，都在上面被忽略
src-tauri/libqookix_lib.so

# 2026-10-04 改为**随包**：这 3 个库必须进 APK，否则 CI 的 checkout 里没有它们 →
# 官方包缺 libc++_shared.so（JVM 硬依赖，libjvm.so 会 dlopen 失败 → 游戏秒退）
# 和 SDL3 / spirv-cross。代价是 APK 从 19MB 回到 ~53MB（用户已确认可以）。
# 渲染器 / 驱动仍然走插件（库源在 `gen/android/plugin-libs/`），这里只是把
# 「随包兜底」这条真的兜住 —— 之前 CI 产物根本兜不住。
src-tauri/gen/android/app/src/main/jniLibs/*/*.bak-unpatched

# 组件（LWJGL 3.4.1 jar/natives + spirv-cross）：2026-10-04 起**入库**。
# 之前不入库 → CI 产物不带它们 → MC 26.3（需要 LWJGL 3.4.1）在官方包里直接起不来。
# 仍然是「插件优先」：运行时优先用插件里的版本，这里的只作随包兜底。
# src-tauri/gen/android/app/src/main/assets-components/

# vite 产物：会被 `tauri::generate_context!` 编进 .so，属于生成物。
# 注意同名目录在仓库里有两处（另一处是遗留脚手架），一起忽略免得混淆。
src-tauri/gen/android/app/src/main/assets/
app/src/main/assets/

# ── 本机 / IDE 配置 ─────────────────────────────────────────────
.idea/
*.iml
.codeartsdoer/

# ── 调试与验证留下的产物（不属于源码）──────────────────────────
# 只忽略项目根目录下的：子目录里的同名文件（如图标、截图资源）要保留。
/*.xml
# ⚠️ 不能写 `/*.txt` —— 会把 LICENSE-LGPL-3.0.txt 一起忽略掉，
#    而 README.md / THIRD_PARTY_NOTICES.md 都链到它，LGPL 合规要求必须入库。
#    只忽略明显是临时日志的那些（下面几条）。
/*-log*.txt
/crash*.txt
/ui_dump*.xml
!LICENSE*.txt
/*.jar
/*.bin
/*.so
/*.json.bak
/*setp*
dev.log
device_settings.json
mf_probe.json
v1211.json
v263.json
/check_*.mjs
/scan_jar.mjs
/mcjar_out/
/*_out/
/maps*.txt

# 插件打包产物（分发的中间物，体积大）
dist-plugins/

# 补丁脚本的编译产物（每次重跑会重建）
scripts/lwjgl-glfw-patch/build/

